{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iot-device-builder-lab",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iot-device-builder-db",
      "database_id": "07b0e3a1-ad4e-402f-abb9-425a02e9e51f"
    }
  ],
  "workers_dev": true
}
